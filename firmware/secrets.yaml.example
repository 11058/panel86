# Скопировать в secrets.yaml (он в .gitignore) и заполнить.

wifi_ssid: "..."
wifi_password: "..."
wifi_fallback_pwd: "panel86setup"

# ESPHome native API. Сгенерировать: openssl rand -base64 32
api_key: "..."
ota_password: "..."

# Нужен только если пойдём по плану Б (свой WebSocket к HA).
# Для плана A (нативный API) токен не нужен вовсе — в этом половина его ценности.
ha_url: "https://homeassistant.local:8123"
ha_token: "..."
